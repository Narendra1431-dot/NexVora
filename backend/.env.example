# Environment Configuration Template
# Copy this file to .env for development, and use environment variables in production

# ==============================================================================
# Database Configuration
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=career_intelligence

# ==============================================================================
# JWT Authentication
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-secure-jwt-secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720
SESSION_COOKIE_NAME=plcip_session
CSRF_COOKIE_NAME=plcip_csrf
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# ==============================================================================
# Application Settings
# ==============================================================================
APP_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Primary LLM Provider: auto, groq, or openrouter
LLM_PROVIDER=auto

# Groq Configuration (used when LLM_PROVIDER=auto and Groq key available)
GROQ_API_KEY=replace-with-your-groq-api-key
groq_model=openai/gpt-oss-120b

# OpenRouter Configuration (used when LLM_PROVIDER=auto and OpenRouter key available)
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
openrouter_model=openai/gpt-4o
openrouter_timeout_seconds=30
openrouter_base_url=https://openrouter.ai/api/v1

# ==============================================================================
# Application URL
# ==============================================================================
PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Background Intelligence Configuration
# ==============================================================================
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
ALLOW_AI_FALLBACK=true
BRAIN_GROQ_MODEL=openai/gpt-oss-120b
VECTOR_STORE=chroma

# ==============================================================================
# Central Brain Settings
# ==============================================================================
ENABLE_CENTRAL_BRAIN=true

# ==============================================================================
# Provider Selection and Fallback
# ==============================================================================
PRIMARY_LLM_PROVIDER=openrouter
BACKGROUND_LLM_PROVIDER=openrouter
FALLBACK_LLM_PROVIDER=groq
OPENROUTER_MODEL=meta-llama/llama-4-scout

# ==============================================================================
# Additional Services
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8003

# ==============================================================================
# File Uploads
# ==============================================================================
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_TYPES=application/pdf,text/plain,text/markdown

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_PER_MINUTE=120
SENSITIVE_RATE_LIMIT_PER_MINUTE=20

# ==============================================================================
# Content Review
# ==============================================================================
# Comma-separated list of email addresses that have project review permissions
REVIEWER_EMAILS=

# ==============================================================================
# Demo Credentials (only for development)
# ==============================================================================
DEMO_EMAIL=
DEMO_PASSWORD=
SEED_ON_STARTUP=false

# ==============================================================================
# Uploads Configuration
# ==============================================================================
# Comma-separated list of allowed upload file types
ALLOWED_UPLOAD_TYPES=application/pdf,text/plain,text/markdown

# Maximum upload size in bytes
MAX_UPLOAD_BYTES=8388608

